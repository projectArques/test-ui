            notif.BorderSizePixel = 0
            notif.Parent = ScreenGui
            
            local ncorner = Instance.new("UICorner")
            ncorner.CornerRadius = UDim.new(0, 6)
            ncorner.Parent = notif
            
            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(1, -20, 0.5, 0)
            title.Position = UDim2.new(0, 10, 0, 4)
            title.BackgroundTransparency = 1
            title.Text = config.Title or "Notification"
            title.TextColor3 = Color3.fromRGB(220, 220, 230)
            title.TextSize = 14
            title.Font = Enum.Font.GothamBold
            title.Parent = notif
            
            local desc = Instance.new("TextLabel")
            desc.Size = UDim2.new(1, -20, 0.5, 0)
            desc.Position = UDim2.new(0, 10, 0.5, 0)
            desc.BackgroundTransparency = 1
            desc.Text = config.Description or ""
            desc.TextColor3 = Color3.fromRGB(160, 160, 170)
            desc.TextSize = 12
            desc.Font = Enum.Font.Gotham
            desc.Parent = notif
            
            game:GetService("Debris"):AddItem(notif, 3)
            
            TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, -320, 0, 10)}):Play()
            task.wait(2.8)
            TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, 0, 0, 10)}):Play()
            task.wait(0.3)
            notif:Destroy()
        end
        
        function Window:Destroy()
            ScreenGui:Destroy()
        end
        
        return Tab
    end
    
    return Window
end

return Sable
