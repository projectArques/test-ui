                    optCorner.CornerRadius = UDim.new(0, 4)
                    optCorner.Parent = opt
                    
                    local optPadding = Instance.new("UIPadding")
                    optPadding.PaddingRight = UDim.new(0, 8)
                    optPadding.PaddingLeft = UDim.new(0, 14)
                    optPadding.PaddingBottom = UDim.new(0, 1)
                    optPadding.Parent = opt
                    
                    if option == valueLabel.Text then
                        local dot = Instance.new("Frame")
                        dot.ZIndex = 102
                        dot.BorderSizePixel = 0
                        dot.BackgroundColor3 = Color3.fromRGB(204, 183, 148)
                        dot.AnchorPoint = Vector2.new(0.5, 0.5)
                        dot.Size = UDim2.new(0, 6, 0, 6)
                        dot.Position = UDim2.new(0, -8, 0.5, 0)
                        dot.Name = "selecteddot"
                        dot.Parent = opt
                        
                        local dotCorner = Instance.new("UICorner")
                        dotCorner.CornerRadius = UDim.new(1, 0)
                        dotCorner.Parent = dot
                    end
                    
                    opt.MouseButton1Click:Connect(function()
                        valueLabel.Text = option
                        if callback then callback(option) end
                        list:Destroy()
                        open = false
                    end)
                end
                
                list.Size = UDim2.new(0, 120, 0, #options * 28 + 32)
                holder.Size = UDim2.new(1, 0, 0, #options * 28 + 16)
            end)
            
            table.insert(tabData.Elements, frame)
            return frame
        end
        
        function Window:Notify(config)
            config = config or {}
            
            local notif = Instance.new("Frame")
            notif.Size = UDim2.new(0, 300, 0, 50)
            notif.Position = UDim2.new(1, -320, 0, 10)
            notif.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
            notif.BorderSizePixel = 0
            notif.Parent = ScreenGui
            
            local ncorner = Instance.new("UICorner")
            ncorner.CornerRadius = UDim.new(0, 6)
            ncorner.Parent = notif
            
            local title = Instance.new("TextLabel")
            title.Size = UDim2.new(1, -20, 0.5, 0)
            title.Position = UDim2.new(0, 10, 0, 4)
            title.BackgroundTransparency = 1
            title.Text = config.Title or "Notification"
            title.TextColor3 = Color3.fromRGB(220, 220, 230)
            title.TextSize = 14
            title.Font = Enum.Font.GothamBold
            title.Parent = notif
            
            local desc = Instance.new("TextLabel")
            desc.Size = UDim2.new(1, -20, 0.5, 0)
            desc.Position = UDim2.new(0, 10, 0.5, 0)
            desc.BackgroundTransparency = 1
            desc.Text = config.Description or ""
            desc.TextColor3 = Color3.fromRGB(160, 160, 170)
            desc.TextSize = 12
            desc.Font = Enum.Font.Gotham
            desc.Parent = notif
            
            game:GetService("Debris"):AddItem(notif, 3)
            
            TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, -320, 0, 10)}):Play()
            task.wait(2.8)
            TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, 0, 0, 10)}):Play()
            task.wait(0.3)
            notif:Destroy()
        end
        
        function Window:Destroy()
            MainFrame:Destroy()
        end
        
        return Tab
    end
    
    return Window
end

return Sable
