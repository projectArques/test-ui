            function Section:AddDropdown(config)
                config = config or {}
                local Name = config.Name or "Dropdown"
                local Options = config.Options or { "Option 1", "Option 2" }
                local Default = config.Default or Options[1]
                local Callback = config.Callback or function() end

                local frame = Instance.new("Frame")
                frame.Size = UDim2.new(1, 0, 0, 36)
                frame.BackgroundColor3 = Colors.Element
                frame.BackgroundTransparency = 0.3
                frame.BorderSizePixel = 0
                frame.ClipsDescendants = false
                frame.Parent = elementContainer
                Corner(frame, 8)

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(0.35, -5, 1, 0)
                label.Position = UDim2.new(0, 14, 0, 0)
                label.BackgroundTransparency = 1
                label.Text = Name
                label.TextColor3 = Colors.Text
                label.TextSize = 13
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.Font = Enum.Font.Gotham
                label.Parent = frame

                local dropdown = Instance.new("TextButton")
                dropdown.Size = UDim2.new(0.65, -15, 1, -8)
                dropdown.Position = UDim2.new(0.35, 0, 0, 4)
                dropdown.BackgroundColor3 = Colors.InputBG
                dropdown.BackgroundTransparency = 0.3
                dropdown.BorderSizePixel = 0
                dropdown.Text = "  " .. tostring(Default)
                dropdown.TextColor3 = Colors.Text
                dropdown.TextSize = 13
                dropdown.TextXAlignment = Enum.TextXAlignment.Left
                dropdown.Font = Enum.Font.Gotham
                dropdown.ZIndex = 20
                dropdown.Parent = frame
                Corner(dropdown, 6)

                local arrow = Instance.new("ImageLabel")
                arrow.Size = UDim2.new(0, 10, 0, 6)
                arrow.Position = UDim2.new(1, -16, 0.5, -3)
                arrow.BackgroundTransparency = 1
                arrow.Image = GetIcon("dropdown")
                arrow.ImageColor3 = Colors.SubText
                arrow.ZIndex = 21
                arrow.Parent = dropdown

                local open = false
                local list = nil

                dropdown.MouseButton1Click:Connect(function()
                    if open then
                        if list then
                            local closingList = list
                            Tween(closingList, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, 0) })
                            task.delay(0.15, function() closingList:Destroy() end)
                            list = nil
                        end
                        Tween(arrow, TweenInfo.new(0.15), { Rotation = 0 })
                        open = false
                        return
                    end

                    open = true
                    Tween(arrow, TweenInfo.new(0.15), { Rotation = 180 })

                    list = Instance.new("Frame")
                    list.ZIndex = 50
                    list.BorderSizePixel = 0
                    list.BackgroundColor3 = Colors.InputBG
                    list.BackgroundTransparency = 0.1
                    list.ClipsDescendants = true
                    list.Size = UDim2.new(1, 0, 0, 0)
                    list.Position = UDim2.new(0, 0, 1, 4)
                    list.Parent = dropdown
                    Corner(list, 8)
                    Stroke(list, Colors.Accent, 0.15, 1)

                    local layout = Instance.new("UIListLayout")
                    layout.Padding = UDim.new(0, 2)
                    layout.SortOrder = Enum.SortOrder.LayoutOrder
                    layout.Parent = list

                    local pad = Instance.new("UIPadding")
                    pad.PaddingTop = UDim.new(0, 4)
                    pad.PaddingBottom = UDim.new(0, 4)
                    pad.PaddingLeft = UDim.new(0, 4)
                    pad.PaddingRight = UDim.new(0, 4)
                    pad.Parent = list

                    for _, option in pairs(Options) do
                        local opt = Instance.new("TextButton")
                        opt.Size = UDim2.new(1, 0, 0, 28)
                        opt.BackgroundColor3 = Colors.Element
                        opt.BackgroundTransparency = 1
                        opt.BorderSizePixel = 0
                        opt.Text = "  " .. option
                        opt.TextColor3 = Colors.Text
                        opt.TextSize = 13
                        opt.TextXAlignment = Enum.TextXAlignment.Left
                        opt.Font = Enum.Font.Gotham
                        opt.ZIndex = 51
                        opt.Parent = list
                        Corner(opt, 6)

                        opt.MouseButton1Click:Connect(function()
                            dropdown.Text = "  " .. option
                            Callback(option)
                            local closingList = list
                            Tween(closingList, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, 0) })
                            Tween(arrow, TweenInfo.new(0.15), { Rotation = 0 })
                            task.delay(0.15, function() closingList:Destroy() end)
                            list = nil
                            open = false
                        end)

                        Hover(opt, function()
                            Tween(opt, TweenInfo.new(0.12), { BackgroundTransparency = 0.4 })
                        end, function()
                            Tween(opt, TweenInfo.new(0.12), { BackgroundTransparency = 1 })
                        end)
                    end

                    Tween(list, TweenInfo.new(0.18), { Size = UDim2.new(1, 0, 0, #Options * 30 + 8) })
                end)

                local obj = {
                    SetValue = function(self, v) dropdown.Text = "  " .. tostring(v) end,
                    GetValue = function() return (dropdown.Text:gsub("^%s+", "")) end
                }
                table.insert(sectionData.Elements, frame)
                return obj
            end

