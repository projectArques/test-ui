        progress.BorderSizePixel = 0
        progress.Parent = progressBg

        Tween(notif, TweenInfo.new(0.35, Enum.EasingStyle.Quint), { Position = UDim2.new(1, -300, 0, 16) })
        Tween(progress, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })

        task.delay(Duration, function()
            Tween(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint), { Position = UDim2.new(1, 20, 0, 16) })
            task.wait(0.3)
            notif:Destroy()
        end)
