                local dot = Instance.new("Frame")
                dot.Size = UDim2.new(0, 14, 0, 14)
                dot.Position = UDim2.new(0, 3, 0.5, -7)
                dot.BackgroundColor3 = Color3.fromRGB(220, 220, 228)
                dot.BorderSizePixel = 0
                dot.Parent = toggle
                Corner(dot, 7)

                -- Dot glow
                local dotGlow = Instance.new("Frame")
                dotGlow.Size = UDim2.new(0, 20, 0, 20)
                dotGlow.Position = UDim2.new(0, -3, 0.5, -10)
                dotGlow.BackgroundColor3 = Colors.Accent
                dotGlow.BackgroundTransparency = 0.9
                dotGlow.BorderSizePixel = 0
                dotGlow.ZIndex = -1
                dotGlow.Parent = toggle
                Corner(dotGlow, 10)

                local state = Default

                local function update()
                    if state then
                        Tween(toggle, TweenInfo.new(0.2), { BackgroundColor3 = Colors.Toggle })
                        Tween(dot, TweenInfo.new(0.2), { Position = UDim2.new(0, 21, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
                        Tween(dotGlow, TweenInfo.new(0.2), { BackgroundTransparency = 0.7 })
                    else
                        Tween(toggle, TweenInfo.new(0.2), { BackgroundColor3 = Colors.InputBG })
                        Tween(dot, TweenInfo.new(0.2), { Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Color3.fromRGB(220, 220, 228) })
                        Tween(dotGlow, TweenInfo.new(0.2), { BackgroundTransparency = 0.9 })
                    end
                end
                update()

                CreateInputButton(frame, function()
                    state = not state
                    update()
                    Callback(state)
                end)

                Hover(frame, function()
                    Tween(frame, TweenInfo.new(0.15), { BackgroundTransparency = 0.1 })
                end, function()
                    Tween(frame, TweenInfo.new(0.15), { BackgroundTransparency = 0.3 })
                end)

                local obj = {
                    SetValue = function(self, v) state = v update() Callback(v) end,
                    GetValue = function() return state end
                }
                table.insert(sectionData.Elements, frame)
                return obj
            end

