                bCorner.CornerRadius = UDim.new(1, 0)
                bCorner.Parent = bar
                
                local fill = Instance.new("Frame")
                fill.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
                fill.BackgroundColor3 = Colors.Highlight
                fill.BorderSizePixel = 0
                fill.Parent = bar
                
                local fCorner = Instance.new("UICorner")
                fCorner.CornerRadius = UDim.new(1, 0)
                fCorner.Parent = fill
                
                local value = Default
                local dragging = false
                
                local function update(input)
                    local pos = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    value = Round(Min + (Max - Min) * pos, 2)
                    fill.Size = UDim2.new(pos, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    Callback(value)
                end
                
                local btn = CreateInputButton(frame)
                btn.MouseButton1Down:Connect(function()
                    dragging = true
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
                        update(input)
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                btn.MouseEnter:Connect(function()
                    frame.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
                end)
                btn.MouseLeave:Connect(function()
                    frame.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
                end)
                
                local obj = { SetValue = function(self, v) value = v fill.Size = UDim2.new((v - Min) / (Max - Min), 0, 1, 0) valueLabel.Text = tostring(v) Callback(v) end, GetValue = function() return value end }
                table.insert(sectionData.Elements, frame)
                return obj
            end
            
