                corner.Parent = frame
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(0.35, -5, 1, 0)
                label.Position = UDim2.new(0, 12, 0, 0)
                label.BackgroundTransparency = 1
                label.Text = Name
                label.TextColor3 = Colors.Text
                label.TextSize = 13
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.Font = Enum.Font.Gotham
                label.Parent = frame
                
                local dropdown = Instance.new("TextButton")
                dropdown.Size = UDim2.new(0.65, -15, 1, -8)
                dropdown.Position = UDim2.new(0.35, 0, 0, 4)
                dropdown.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
                dropdown.BorderSizePixel = 0
                dropdown.Text = Default
                dropdown.TextColor3 = Colors.Text
                dropdown.TextSize = 13
                dropdown.Font = Enum.Font.Gotham
                dropdown.Parent = frame
                
                local dCorner = Instance.new("UICorner")
                dCorner.CornerRadius = UDim.new(0, 4)
                dCorner.Parent = dropdown
                
                local arrow = Instance.new("ImageLabel")
                arrow.Size = UDim2.new(0, 10, 0, 6)
                arrow.Position = UDim2.new(1, -14, 0.5, -3)
                arrow.BackgroundTransparency = 1
                arrow.Image = GetIcon("dropdown")
                arrow.ImageColor3 = Colors.SubText
                arrow.Parent = dropdown
                
                local open = false
                local list = nil
                
                dropdown.MouseButton1Click:Connect(function()
                    if open then
                        if list then list:Destroy() end
                        open = false
                        return
                    end
                    
                    open = true
                    list = Instance.new("Frame")
                    list.ZIndex = 100
                    list.BorderSizePixel = 0
                    list.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
                    list.ClipsDescendants = true
                    list.Size = UDim2.new(1, 0, 0, 0)
                    list.Position = UDim2.new(0, 0, 1, 2)
                    list.Parent = dropdown
                    
                    local lCorner = Instance.new("UICorner")
                    lCorner.CornerRadius = UDim.new(0, 4)
                    lCorner.Parent = list
                    
                    local layout = Instance.new("UIListLayout")
                    layout.Padding = UDim.new(0, 2)
                    layout.SortOrder = Enum.SortOrder.LayoutOrder
                    layout.Parent = list
                    
                    for i, option in pairs(Options) do
                        local opt = Instance.new("TextButton")
                        opt.Size = UDim2.new(1, -10, 0, 28)
                        opt.Position = UDim2.new(0, 5, 0, 0)
                        opt.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                        opt.BorderSizePixel = 0
                        opt.Text = option
                        opt.TextColor3 = Colors.Text
                        opt.TextSize = 13
                        opt.Font = Enum.Font.Gotham
                        opt.Parent = list
                        
                        local oCorner = Instance.new("UICorner")
                        oCorner.CornerRadius = UDim.new(0, 4)
                        oCorner.Parent = opt
                        
                        opt.MouseButton1Click:Connect(function()
                            dropdown.Text = option
                            Callback(option)
                            list:Destroy()
                            open = false
                        end)
                        
                        opt.MouseEnter:Connect(function()
                            opt.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
                        end)
                        opt.MouseLeave:Connect(function()
                            opt.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                        end)
                    end
                    
                    list.Size = UDim2.new(1, 0, 0, #Options * 30 + 4)
                end)
                
                local obj = { SetValue = function(self, v) dropdown.Text = v end, GetValue = function() return dropdown.Text end }
                table.insert(sectionData.Elements, frame)
                return obj
            end
            
