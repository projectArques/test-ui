    function Window:Destroy()
        ScreenGui:Destroy()
    end
    
    function Window:GetFlags()
        return Flags
    end
    
    function Window:SetFlag(name, value)
        if Flags[name] then
            Flags[name]:SetValue(value)
        end
    end
    
    function Window:GetFlag(name)
        if Flags[name] then
            return Flags[name]:GetValue()
        end
        return nil
    end
    
    return Window
