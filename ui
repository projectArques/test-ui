local function SwitchTab(tabData)
    for _, child in pairs(ContentContainer:GetChildren()) do
        if child:IsA("Frame") and child ~= ContentLayout and child ~= ContentPadding then
            child:Destroy()
        end
    end
    
    for _, element in pairs(tabData.Elements or {}) do
        element.Parent = ContentContainer
    end
    
    CurrentTab = tabData
    task.wait()
    ContentContainer.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
end

