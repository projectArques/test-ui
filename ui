local function SwitchTab(tabData)
    for _, child in pairs(PanelContent:GetChildren()) do
        if child:IsA("Frame") and child ~= ContentLayout and child ~= ContentPadding then
            child:Destroy()
        end
    end
    
    for _, element in pairs(tabData.Elements or {}) do
        element.Parent = PanelContent
    end
    
    CurrentTab = tabData
    task.wait()
    PanelContent.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
end

function Sable:CreateWindow(config)
    config = config or {}
    
    if config.Name then
        Brand.Text = config.Name
    end
    
    local keybind = config.Keybind or "RightAlt"
    if type(keybind) == "string" then
        keybind = Enum.KeyCode[keybind] or Enum.KeyCode.RightAlt
    end
    
    KeyHintKey.Text = keybind.Name or "RightAlt"
    
    local function ToggleUI()
        PanelOpen = not PanelOpen
        if PanelOpen then
            Panel.Visible = true
            task.wait()
            local height = math.min(350, ContentLayout.AbsoluteContentSize.Y + 40)
            if height < 50 then height = 100 end
            Panel:TweenSize(UDim2.new(0, 300, 0, height), "Out", "Quad", 0.3, true)
            Chevron.Rotation = 0
        else
            Panel:TweenSize(UDim2.new(0, 300, 0, 0), "Out", "Quad", 0.2, true)
            task.wait(0.25)
            Panel.Visible = false
            Chevron.Rotation = 180
        end
    end
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == keybind then
            ToggleUI()
        end
    end)
    
    Chevron.MouseButton1Click:Connect(ToggleUI)
    
