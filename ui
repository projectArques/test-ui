            corner.Parent = frame
            
            local padding = Instance.new("UIPadding")
            padding.PaddingRight = UDim.new(0, 10)
            padding.PaddingLeft = UDim.new(0, 10)
            padding.Parent = frame
            
            local row = Instance.new("Frame")
            row.ZIndex = 99
            row.BorderSizePixel = 0
            row.Size = UDim2.new(1, 0, 0, 48)
            row.Name = "dropdown_" .. text
            row.BackgroundTransparency = 1
            row.Parent = frame
            
            local compName = Instance.new("TextLabel")
            compName.BorderSizePixel = 0
            compName.TextSize = 13
            compName.TextXAlignment = Enum.TextXAlignment.Left
            compName.Font = Enum.Font.GothamMedium
            compName.TextColor3 = Color3.fromRGB(220, 220, 230)
            compName.BackgroundTransparency = 1
            compName.Size = UDim2.new(0.35, -5, 1, 0)
            compName.Text = text
            compName.Name = "Componentname"
            compName.Parent = row
            
            local dropdownBtn = Instance.new("TextButton")
            dropdownBtn.BorderSizePixel = 0
            dropdownBtn.TextSize = 13
            dropdownBtn.TextXAlignment = Enum.TextXAlignment.Left
            dropdownBtn.AutoButtonColor = false
            dropdownBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
            dropdownBtn.Font = Enum.Font.GothamMedium
            dropdownBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            dropdownBtn.Size = UDim2.new(0.65, -5, 1, -10)
            dropdownBtn.Position = UDim2.new(0.35, 0, 0, 5)
            dropdownBtn.Text = default or options[1] or ""
            dropdownBtn.Name = "dropdownbtn"
            dropdownBtn.Parent = row
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = dropdownBtn
            
            local arrow = Instance.new("ImageLabel")
            arrow.BorderSizePixel = 0
            arrow.ImageColor3 = Color3.fromRGB(150, 150, 160)
            arrow.AnchorPoint = Vector2.new(1, 0.5)
            arrow.Image = "rbxassetid://138715549597115"
            arrow.Size = UDim2.new(0, 10, 0, 6)
            arrow.Position = UDim2.new(1, -10, 0.5, 0)
            arrow.BackgroundTransparency = 1
            arrow.Name = "arrow"
            arrow.Parent = dropdownBtn
            
            local open = false
            local list = nil
            
            dropdownBtn.MouseButton1Click:Connect(function()
                if open then
                    if list then list:Destroy() end
                    open = false
                    return
                end
                
                open = true
                list = Instance.new("Frame")
                list.ZIndex = 100
                list.BorderSizePixel = 0
                list.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
                list.ClipsDescendants = true
                list.Size = UDim2.new(1, 0, 0, 0)
                list.Position = UDim2.new(0, 0, 1, 2)
                list.Name = "DropdownList"
                list.Parent = dropdownBtn
                
                local listCorner = Instance.new("UICorner")
                listCorner.CornerRadius = UDim.new(0, 6)
                listCorner.Parent = list
                
                local listLayout = Instance.new("UIListLayout")
                listLayout.Padding = UDim.new(0, 2)
                listLayout.SortOrder = Enum.SortOrder.LayoutOrder
                listLayout.Parent = list
                
                for i, option in pairs(options) do
                    local opt = Instance.new("TextButton")
                    opt.BorderSizePixel = 0
                    opt.TextSize = 13
                    opt.TextXAlignment = Enum.TextXAlignment.Left
                    opt.AutoButtonColor = false
                    opt.TextColor3 = Color3.fromRGB(220, 220, 230)
                    opt.Font = Enum.Font.GothamMedium
                    opt.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                    opt.Size = UDim2.new(1, -10, 0, 28)
                    opt.Position = UDim2.new(0, 5, 0, 0)
                    opt.Text = option
                    opt.Name = "option_" .. option
                    opt.Parent = list
                    
                    local optCorner = Instance.new("UICorner")
                    optCorner.CornerRadius = UDim.new(0, 4)
                    optCorner.Parent = opt
                    
                    local optPadding = Instance.new("UIPadding")
                    optPadding.PaddingLeft = UDim.new(0, 10)
                    optPadding.Parent = opt
                    
                    opt.MouseButton1Click:Connect(function()
                        dropdownBtn.Text = option
                        if callback then callback(option) end
                        list:Destroy()
                        open = false
                    end)
                    
                    opt.MouseEnter:Connect(function()
                        opt.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
                    end)
                    
                    opt.MouseLeave:Connect(function()
                        opt.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
                    end)
                end
                
                local totalHeight = #options * 30 + 4
                list.Size = UDim2.new(1, 0, 0, totalHeight)
            end)
            
            table.insert(tabData.Elements, frame)
            if CurrentTab == tabData then
                SwitchTab(tabData)
            end
            return frame
        end
        
