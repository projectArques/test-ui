        function Tab:CreateDropdown(text, options, default, callback)
            local frame = Instance.new("Frame")
            frame.ZIndex = 99
            frame.BorderSizePixel = 0
            frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            frame.AutomaticSize = Enum.AutomaticSize.Y
